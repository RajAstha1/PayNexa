# Where the Next.js server (BFF) reaches the backend services. Server-side only; the browser never sees these.
IDENTITY_URL=http://localhost:8081
PAYMENTS_URL=http://localhost:8082
NOTIFICATIONS_URL=http://localhost:8083

# Browser origins allowed to make state-changing requests to the BFF (comma separated).
# Defaults to the request's own origin when unset.
# ALLOWED_ORIGINS=http://localhost:3000
