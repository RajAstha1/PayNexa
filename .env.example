# Copy to .env and fill in. NEVER commit .env. Generate values with scripts/generate-dev-secrets.sh.

# --- PostgreSQL (the compose file creates one database and the per-service roles from infra/postgres) ---
POSTGRES_ADMIN_PASSWORD=
IDENTITY_MIGRATOR_PW=
IDENTITY_APP_PW=
PAYMENTS_MIGRATOR_PW=
PAYMENTS_APP_PW=
NOTIFICATION_MIGRATOR_PW=
NOTIFICATION_APP_PW=

# --- Token signing (RS256). Keys are files under ./secrets, created by scripts/generate-dev-secrets.sh ---
# identity-service reads secrets/jwt-private.pem; payments and notification services read secrets/jwt-public.pem

# --- Synthetic-money helpers: leave false anywhere real value could be affected ---
PAYNEXA_SANDBOX_FUNDING=true

# --- Optional first administrator (sandbox convenience). Leave empty to create none. ---
PAYNEXA_BOOTSTRAP_ADMIN_EMAIL=
PAYNEXA_BOOTSTRAP_ADMIN_PASSWORD=
